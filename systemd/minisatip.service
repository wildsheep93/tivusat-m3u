[Unit]
Description=Mini SAT>IP server
After=network-online.target
Wants=network-online.target 

[Service]
User=minisatip
Group=minisatip
RuntimeDirectory=minisatip
RuntimeDirectoryMode=0755
Type=simple
AmbientCapabilities=CAP_NET_BIND_SERVICE
EnvironmentFile=-/etc/minisatip.conf
ExecStart=/usr/bin/minisatip -f -R /usr/share/minisatip/html -z /run/minisatip $SERVER_ARGS
Restart=on-failure

[Install]
WantedBy=multi-user.target
